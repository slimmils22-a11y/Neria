    "check_preferences_guard": {"method": "GET", "params": {"neria_email": "{{customer_email}}", "neria_template": "order_conf"}},
    "check_cooldown_guest_notice": {"method": "GET", "params": {"neria_email": "{{customer_email}}", "neria_template": "order_conf", "neria_order_ref": "", "neria_send_at": "", "neria_subject": ""}},
    "check_anniversary_guard": {"method": "GET", "params": {"neria_email": "{{customer_email}}", "neria_template": "first_anniversary", "neria_order_ref": "", "neria_send_at": "", "neria_subject": ""}},
    "product_search": {"method": "GET", "params": {"q": "a"}},
    "search_translations": {"method": "GET", "params": {"q": "a", "trad_lang": "fr", "trad_template": "order_conf"}},
    "export_translations_csv": {"method": "GET", "params": {"trad_lang": "fr", "trad_template": "order_conf", "all_langs": "0"}},
    "upsell_preview": {"method": "GET", "params": {"id_order": "{{first:orders:id_order}}", "order_q": ""}},
    "preview_signature": {"method": "GET", "params": {"sig_name": "Test", "sig_title": "Maison", "sig_style": "script", "sig_color": "#2b2520"}},
    "watchdog_refresh": {"method": "GET", "params": {}},
    "search_customers": {"method": "GET", "params": {"q": "a"}},
    "cert_download": {"method": "GET", "params": {"id_certificate": "{{first:neria_certificate:id_certificate}}"}},
    "gdpr_pdf": {"method": "GET", "params": {"neria_tab": "gdpr"}}
