    "look_rule_delete": {"method": "POST", "params": {"_seed": ["INSERT INTO {p}neria_look_rule (id_category,product_ids,active,created_at) VALUES (2,'[1]',1,NOW())"], "look_rule_id": "{{max:neria_look_rule:id_neria_look_rule}}"}},
