    "collection_delete": {"method": "POST", "params": {"collection_id": "{{first:neria_collection:id_neria_collection}}"}},
    "look_rule_add": {"method": "POST", "params": {"look_category_id": "{{first:category:id_category}}", "look_product_ids": "{{first:product:id_product}}"}},
